// Windows resource script.
//
// The icon must be embedded in the executable, not merely set at runtime:
// Explorer, the taskbar's pinned entries and the installer all read the icon
// from the binary's resources without launching it. IDI_ICON1 as the first
// icon is the conventional id Windows picks up for the application icon.

#include <windows.h>

IDI_ICON1 ICON "icons/generated/keys.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     KEYS_VERSION_RC
    PRODUCTVERSION  KEYS_VERSION_RC
    FILEOS          VOS__WINDOWS32
    FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0 = US English, Unicode.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Keys"
            VALUE "FileDescription",  "Keys"
            VALUE "FileVersion",      KEYS_VERSION_STR
            VALUE "InternalName",     "keys"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "keys.exe"
            VALUE "ProductName",      "Keys"
            VALUE "ProductVersion",   KEYS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
